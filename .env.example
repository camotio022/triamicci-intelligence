# Local UI/server configuration. Never commit credential values.
PUBLIC_APP_URL=https://localhost.example
APP_ENV=staging
FIREBASE_EXPECTED_PROJECT_ID=demo-triamicci-v31
# Server credentials must be configured privately by the operator.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# For a separate staging frontend, supply its public Firebase configuration:
# VITE_APP_ENV=staging
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=

# Optional, server only. Use a Gemini Developer API key from Google AI Studio.
# Configure in Preview first to evaluate handwritten production notes.
GEMINI_API_KEY=

# Local homologation (emulators only, no real Firebase data). Used by npm run homolog:* commands.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-triamicci-v31
# VITE_FIREBASE_AUTH_DOMAIN=demo-triamicci-v31.firebaseapp.com
