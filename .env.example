# Local UI/server configuration. Never commit credential values.
PUBLIC_APP_URL=https://localhost.example
APP_ENV=staging
FIREBASE_EXPECTED_PROJECT_ID=demo-triamicci-v31
# Server credentials must be configured privately by the operator.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# For a separate staging frontend, supply its public Firebase configuration:
# VITE_APP_ENV=staging
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=

# Optional server-only handwriting OCR. Requires Google Cloud Vision API and billing enabled.
# Uses FIREBASE_SERVICE_ACCOUNT_JSON service account for OAuth; never expose credentials to Vite.
# PHOTO_OCR_PROVIDER=google-vision
